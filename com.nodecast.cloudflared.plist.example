<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nodecast.cloudflared</string>

    <!-- 
         Named tunnel example (recommended after you run the setup script and create 'nodecast-tv' tunnel).
         This keeps a stable Cloudflare tunnel to your Fly app.
         Requires: cloudflared in PATH (usually /usr/local/bin/cloudflared on Mac with brew)
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cloudflared</string>
        <string>tunnel</string>
        <string>run</string>
        <string>--url</string>
        <string>https://nodecast-tv-zsivasto.fly.dev</string>
        <string>nodecast-tv</string>
    </array>

    <!-- Quick/ephemeral alternative (no named tunnel, new random URL each time Mac launches it):
    <array>
        <string>/usr/local/bin/cloudflared</string>
        <string>tunnel</string>
        <string>--url</string>
        <string>https://nodecast-tv-zsivasto.fly.dev</string>
    </array>
    -->

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/tmp/cloudflared-nodecast.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cloudflared-nodecast.log</string>

    <!-- Optional: only run when user is logged in (good for tunnels) -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
