# nodecast-tv Environment Variables
# Copy to .env and fill in for production

NODE_ENV=production
PORT=3000

# Optional: Database path (default ./data/content.db)
# DB_PATH=/app/data/content.db

# For OIDC SSO (optional, see docs)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URL=

# Transcoding hardware (on Oracle free usually software)
# HW_ENCODER=software
